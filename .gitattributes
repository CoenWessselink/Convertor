# Keep binary release, runtime and evidence artifacts byte-exact on every OS.
*.zip binary
*.exe binary
*.dll binary
*.png binary
*.jpg binary
*.jpeg binary
*.ifc binary
*.step binary
*.stp binary
*.tsep binary

# Text files use LF in the repository; Git may present platform-native endings
# only where that cannot affect hashes or embedded runtime payloads.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf

# Acceptance reports hash their raw output logs; never rewrite those bytes.
validation/product_integration/** -text whitespace=cr-at-eol

# Generated CAD/PDF/package evidence contains format-significant whitespace.
# Keep its byte hashes intact and review it through the readable matrix index.
validation/product_integration/**/W18_POSITIVE_MATRIX-artifacts-*/** -diff
