 def _traceability(project, maps):
+    """Return one BOM-lineage row for every canonical BOM entity.
+
+    Assemblies are grouping/lineage nodes, not a second quantitative copy of
+    their children.  Occurrence/product/source identifiers remain explicit so
+    repeated geometry can be audited without collapsing physical occurrences.
+    """
+    parent_assemblies: dict[str, set[str]] = defaultdict(set)
+    for assembly in project.assemblies.values():
+        for child_id in assembly.child_assembly_ids:
+            parent_assemblies[child_id].add(assembly.internal_id)
+        for entity_id in (*assembly.part_ids, *assembly.purchased_item_ids,
+                          *assembly.fastener_ids, *assembly.weld_ids):
+            parent_assemblies[entity_id].add(assembly.internal_id)
+
